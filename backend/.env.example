APP_NAME=DermaScan Backend
APP_ENV=development
DEBUG=true

# database — docker dev-postgres (host port 5434)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=dermascan
DB_PORT=5434
DB_SSL_MODE=disable

# auth — wajib diisi di luar development.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=

# Google Sign-In — Web application Client ID (bukan Android Client ID).
# Dipakai memverifikasi id_token dari Flutter (serverClientId).
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# SMTP — kode verifikasi email saat registrasi (Gmail: pakai App Password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=skinscan59@gmail.com
# SMTP_PASS=
# SMTP_FROM=skinscan59@gmail.com
# EMAIL_VERIFICATION_EXPIRE_MINUTES=15

# ML (opsional) — default sudah cocok untuk repo ini.
# Inferensi butuh paket di requirements-ml.txt (ai-edge-litert; TensorFlow opsional).
# ML_MODEL_PATH=app/ml/artifacts/dermascan_custom_cnn.tflite
# ML_INPUT_SIZE=160
# ML_MAX_UPLOAD_MB=10

# Scan history photos (local VPS disk; relative paths resolve against backend/).
# HISTORY_UPLOAD_DIR=uploads/history
# HISTORY_MAX_UPLOAD_MB=10

# LLM rekomendasi perawatan kulit (endpoint kompatibel OpenAI, mis. InferHub).
# Kosongkan LLM_API_KEY jika layanan AI belum dipakai (status rekomendasi tetap pending).
# LLM_BASE_URL=https://api.inferhub.dev/v1
# LLM_API_KEY=sk-airo-...
# LLM_MODEL=ocg/glm-5.1
# LLM_TIMEOUT_SECONDS=45
