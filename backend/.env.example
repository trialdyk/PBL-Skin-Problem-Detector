APP_NAME=DermaScan Backend
APP_ENV=development
DEBUG=true

# database — docker dev-postgres (host port 5434)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=dermascan
DB_PORT=5434
DB_SSL_MODE=disable

# auth — wajib diisi di luar development.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=

# Google Sign-In — Web application Client ID (bukan Android Client ID).
# Dipakai memverifikasi id_token dari Flutter (serverClientId).
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ML (opsional) — default sudah cocok untuk repo ini.
# Inferensi butuh paket di requirements-ml.txt (ai-edge-litert; TensorFlow opsional).
# ML_MODEL_PATH=app/ml/artifacts/dermascan_custom_cnn.tflite
# ML_INPUT_SIZE=160
# ML_MAX_UPLOAD_MB=10
