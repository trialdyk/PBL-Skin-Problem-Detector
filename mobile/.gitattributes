# Flutter's tooling regenerates the plugin registrant files with LF line
# endings. This repository has `core.autocrlf=true`, so on Windows Git keeps
# reporting those generated files as modified after every `flutter pub get`,
# `flutter analyze`, `flutter test`, or build. Pin them to LF so the working
# tree stays clean.
windows/flutter/generated_* text eol=lf
linux/flutter/generated_* text eol=lf
macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf
