        "import zipfile\n",
        "from pathlib import Path\n",
        "import pandas as pd\n",
        "from google.colab import drive\n",
        "\n",
        "# 1. Mount Google Drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# 2. Tentukan path file ZIP di Google Drive dan folder tujuan ekstrak di lokal Colab\n",
        "# Ubah path DATA_ZIP sesuai dengan lokasi file zip di Google Drive kamu\n",
        "DATA_ZIP = Path(\"/content/drive/MyDrive/!PBL5/data_clean5_384.zip\")\n",
        "DATA_ROOT = Path(\"/content/dataset\") # Diekstrak ke lokal Colab agar pembacaan gambar cepat\n",
        "\n",
        "# Pastikan CLASS_NAMES sudah didefinisikan sebelumnya (contoh jika belum ada):\n",
        "# CLASS_NAMES = [\"IGA0_IGA1\", \"IGA2\", \"IGA3\", \"IGA4\"]\n",
        "\n",
        "# 3. Ekstrak file ZIP dari Google Drive ke Colab\n",
        "if not DATA_ROOT.exists():\n",
        "    if not DATA_ZIP.exists():\n",
        "        raise FileNotFoundError(f\"File ZIP tidak ditemukan di Google Drive: {DATA_ZIP}\")\n",
        "\n",
        "    DATA_ROOT.mkdir(parents=True, exist_ok=True)\n",
        "    with zipfile.ZipFile(DATA_ZIP, 'r') as archive:\n",
        "        archive.extractall(DATA_ROOT)\n",
        "    print(\"Extracted to\", DATA_ROOT)\n",
        "\n",
        "# Catatan: Jika di dalam ZIP terdapat 1 folder induk lagi (misal: /content/dataset/nama_folder/splits.csv),\n",
        "# sesuaikan DATA_ROOT menjadi: DATA_ROOT = Path(\"/content/dataset/nama_folder\")\n",
        "\n",
        "# 4. Baca CSV dan susun path file\n",
        "SPLITS = pd.read_csv(DATA_ROOT / \"splits.csv\")\n",
        "SPLITS[\"path\"] = [\n",
        "    DATA_ROOT / split / label / name\n",
        "    for split, label, name in zip(SPLITS[\"split\"], SPLITS[\"label\"], SPLITS[\"file\"])\n",
        "]\n",
        "\n",
        "# 5. Validasi keberadaan file\n",
        "missing = [str(p) for p in SPLITS[\"path\"] if not p.exists()]\n",
        "assert not missing, f\"{len(missing)} file hilang, contoh: {missing[:3]}\"\n",
        "\n",
        "# 6. Siapkan metadata\n",
        "META = SPLITS.rename(columns={\"file\": \"file_name\", \"label\": \"grade\"}).copy()\n",
        "META[\"severity\"] = META[\"grade\"].replace({\"IGA0\": \"IGA0_IGA1\", \"IGA1\": \"IGA0_IGA1\"})\n",
        "META[\"level\"] = META[\"severity\"].map({name: i for i, name in enumerate(CLASS_NAMES)}).astype(int)\n",
        "\n",
        "print(len(META), \"images\")\n",
        "display(META.head())\n"
      ]
