        "## 5. Models template\n",
        "\n",
        "- `fit(data, idx)`: trains on the images at `idx` and returns a dict with the trained model\n",
        "- `predict(fitted, data, idx)`\n",
        "- `save(fitted, folder)` / `load(folder)`\n",
        "\n",
        "`run()` saves each model's results per fold to `RESULTS_DIR`"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 18,
      "id": "a6bdbcb5",
      "metadata": {
        "id": "a6bdbcb5"
      },
      "outputs": [],
      "source": [
        "@dataclass(frozen=True)\n",
        "class ModelSpec:\n",
        "    name: str\n",
        "    fit: Callable\n",
        "    predict: Callable\n",
        "    save: Callable\n",
        "    load: Callable\n",
        "\n",
        "\n",
        "def save_joblib(fitted, folder):\n",
        "    folder.mkdir(parents=True, exist_ok=True)\n",
        "    joblib.dump(fitted, folder / \"model.joblib\")\n",
        "\n",
        "\n",
        "def load_joblib(folder):\n",
        "    return joblib.load(folder / \"model.joblib\")\n",
        "\n",
        "\n",
        "def cross_validate(spec, data, folds=range(N_FOLDS)):\n",
        "    fold_rows, pred_rows = [], []\n",
        "    for k in folds:\n",
        "        train_idx, test_idx = data.fold(k)\n",
        "        start = time.time()\n",
        "        fitted = spec.fit(data, train_idx)\n",
        "        y_pred = spec.predict(fitted, data, test_idx).argmax(axis=1)\n",
        "        fold_rows.append({\"model\": spec.name, \"fold\": k, **metrics(data.y[test_idx], y_pred),\n",
        "                          \"params\": str(fitted.get(\"params\", \"\")), \"seconds\": round(time.time() - start, 1)})\n",
        "        pred_rows.append(pd.DataFrame({\"model\": spec.name, \"fold\": k, \"index\": test_idx,\n",
        "                                       \"y_true\": data.y[test_idx], \"y_pred\": y_pred}))\n",
        "        print(f\"{spec.name} fold {k}: macro-F1 {fold_rows[-1]['macro_f1']:.3f}\")\n",
        "    return {\"folds\": pd.DataFrame(fold_rows), \"predictions\": pd.concat(pred_rows, ignore_index=True)}\n",
        "\n",
        "\n",
        "def run(names, folds=range(N_FOLDS), force=False):\n",
        "    results = {}\n",
        "    for name in names:\n",
        "        folder = RESULTS_DIR / name\n",
        "        if (folder / \"folds.csv\").exists() and not force:\n",
        "            results[name] = {part: pd.read_csv(folder / f\"{part}.csv\") for part in [\"folds\", \"predictions\"]}\n",
        "            print(f\"{name}: loaded saved results\")\n",
        "            continue\n",
        "        results[name] = cross_validate(MODELS[name], DATA, folds)\n",
        "        folder.mkdir(parents=True, exist_ok=True)\n",
        "        for part, frame in results[name].items():\n",
        "            frame.to_csv(folder / f\"{part}.csv\", index=False)\n",
        "    return results"
      ]
    },
