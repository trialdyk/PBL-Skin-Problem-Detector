        "MODEL_NAME = \"cnn_scratch\"\n",
        "FINAL = {}\n",
        "\n",
        "\n",
        "def final_model(name, refit=False):\n",
        "    folder = EXPORT_DIR / name\n",
        "    if name not in FINAL or refit:\n",
        "        if folder.exists() and not refit:\n",
        "            FINAL[name] = MODELS[name].load(folder)\n",
        "        else:\n",
        "            FINAL[name] = MODELS[name].fit(DATA, np.arange(len(DATA.y)))\n",
        "    return FINAL[name]\n",
        "\n",
        "\n",
        "def photo_data(img):\n",
        "    arr, box = letterbox(upright(img))\n",
        "    return Data(None, arr[None], np.array([box]), np.array([-1]), pd.DataFrame(), np.zeros((1, 0), bool))\n",
        "\n",
        "\n",
        "def show_prediction(img, scores, title):\n",
        "    fig, (left, right) = plt.subplots(1, 2, figsize=(9, 3.6), gridspec_kw={\"width_ratios\": [1, 1.3]})\n",
        "    left.imshow(img)\n",
        "    left.axis(\"off\")\n",
        "    left.set_title(title, fontsize=9)\n",
        "    right.barh(CLASS_NAMES, scores, color=[\"tab:blue\" if i == scores.argmax() else \"lightgray\" for i in LABELS])\n",
        "    right.invert_yaxis()\n",
        "    right.set_xlabel(\"score\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "9b0a1adb",
      "metadata": {
        "id": "9b0a1adb"
      },
      "source": [
        "### Contoh gambar dari dataset\n",
        "\n",
        "Prediksi dari hasil cross-validation: dibuat oleh model fold yang **tidak pernah** melihat gambar ini.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "d45331d4",
      "metadata": {
        "id": "d45331d4"
      },
      "outputs": [],
      "source": [
        "# A random prediction from images in the dataset\n",
        "row = RESULTS[MODEL_NAME][\"predictions\"].sample(1).iloc[0]\n",
        "IMAGE_INDEX = int(row[\"index\"])\n",
        "print(f\"#{IMAGE_INDEX} {DATA.meta.file_name[IMAGE_INDEX]}: true {CLASS_NAMES[row.y_true]}, \"\n",
        "      f\"predicted {CLASS_NAMES[row.y_pred]} (fold {row.fold})\")\n",
        "plt.imshow(DATA.images[IMAGE_INDEX])\n",
        "plt.axis(\"off\")\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "cell-56",
      "metadata": {
        "id": "cell-56"
      },
      "source": [
        "### Holdout test (262 gambar)\n",
        "\n",
        "Dipakai **sekali** di akhir. Model di-fit ulang di seluruh `DATA` (1.462 gambar train+valid), lalu diuji di `test` yang tidak pernah dilihat model mana pun. Ini satu-satunya angka yang boleh dikutip sebagai performa.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "cell-57",
      "metadata": {
        "id": "cell-57"
      },
      "outputs": [],
      "source": [
        "from sklearn.metrics import classification_report\n",
        "\n",
        "HOLDOUT_NAMES = [name for name in MODELS if name in RESULTS]\n",
        "holdout_idx = np.arange(len(HOLDOUT.y))\n",
        "\n",
        "HOLDOUT_PRED, holdout_rows = {}, []\n",
        "for name in HOLDOUT_NAMES:\n",
        "    scores = MODELS[name].predict(final_model(name), HOLDOUT, holdout_idx)\n",
        "    y_pred = scores.argmax(axis=1)\n",
        "    HOLDOUT_PRED[name] = y_pred\n",
        "    holdout_rows.append({\"model\": name, **metrics(HOLDOUT.y, y_pred), \"n\": len(HOLDOUT.y)})\n",
        "\n",
        "HOLDOUT_SCORES = pd.DataFrame(holdout_rows).set_index(\"model\")\n",
        "RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n",
        "HOLDOUT_SCORES.to_csv(RESULTS_DIR / \"holdout.csv\")\n",
        "display(HOLDOUT_SCORES[[\"accuracy\", \"macro_f1\", \"balanced_accuracy\", \"qwk\", \"mae\"]].round(3))\n",
        "\n",
        "for name, y_pred in HOLDOUT_PRED.items():\n",
        "    print(f\"== {name} (holdout, n={len(y_pred)})\")\n",
        "    print(classification_report(HOLDOUT.y, y_pred, labels=LABELS, target_names=CLASS_NAMES,\n",
        "                                digits=3, zero_division=0))\n",
        "\n",
        "fig, axes = plt.subplots(1, len(HOLDOUT_NAMES), figsize=(4.4 * len(HOLDOUT_NAMES), 3.8), squeeze=False)\n",
        "for ax, name in zip(axes.flat, HOLDOUT_NAMES):\n",
        "    cm = confusion_matrix(HOLDOUT.y, HOLDOUT_PRED[name], labels=LABELS, normalize=\"true\")\n",
        "    ax.imshow(cm, cmap=\"Blues\", vmin=0, vmax=1)\n",
        "    for (r, c), v in np.ndenumerate(cm):\n",
        "        ax.text(c, r, f\"{v:.2f}\", ha=\"center\", va=\"center\", color=\"white\" if v > 0.5 else \"black\")\n",
        "    ax.set_xticks(LABELS, CLASS_NAMES, rotation=30)\n",
        "    ax.set_yticks(LABELS, CLASS_NAMES)\n",
        "    ax.set_xlabel(\"predicted\")\n",
        "    ax.set_ylabel(\"true\")\n",
        "    ax.set_title(f\"{name} (holdout)\", fontsize=9)\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    },
