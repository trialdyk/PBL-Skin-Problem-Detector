      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "CNN device: cuda\n"
          ]
        }
      ],
      "source": [
        "import torch\n",
        "import torch.nn.functional as F\n",
        "from torch import nn\n",
        "\n",
        "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "\n",
        "\n",
        "@dataclass(frozen=True)\n",
        "class CnnCfg:\n",
        "    size: int = 256\n",
        "    widths: tuple = (32, 64, 128, 256, 256)\n",
        "    epochs: int = 40\n",
        "    batch: int = 32\n",
        "    lr: float = 1e-3\n",
        "    weight_decay: float = 1e-4\n",
        "    dropout: float = 0.3\n",
        "\n",
        "\n",
        "def small_cnn(cfg):\n",
        "    layers, channels = [], 3\n",
        "    for width in cfg.widths:\n",
        "        layers += [\n",
        "            nn.Conv2d(channels, width, 3, padding=1, bias=False), nn.BatchNorm2d(width), nn.ReLU(inplace=True),\n",
        "            nn.Conv2d(width, width, 3, padding=1, bias=False), nn.BatchNorm2d(width), nn.ReLU(inplace=True),\n",
        "            nn.MaxPool2d(2),\n",
        "        ]\n",
        "        channels = width\n",
        "    return nn.Sequential(*layers, nn.AdaptiveAvgPool2d(1), nn.Flatten(), nn.Dropout(cfg.dropout),\n",
        "                         nn.Linear(channels, len(CLASS_NAMES)))\n",
        "\n",
        "\n",
        "def to_input(images, size):\n",
        "    \"\"\"uint8 (n, H, W, 3) -> float (n, 3, size, size), scaled so the gray padding is about 0.\"\"\"\n",
        "    x = images.permute(0, 3, 1, 2).float().div(255).sub(0.5).div(0.25)\n",
        "    if x.shape[-1] != size:\n",
        "        x = F.interpolate(x, size=(size, size), mode=\"bilinear\", antialias=True, align_corners=False)\n",
        "    return x\n",
        "\n",
        "\n",
        "def augment(x):\n",
        "    \"\"\"Random horizontal flip, zoom 0.9-1.1 and shift up to 10%, different for every image.\"\"\"\n",
        "    n = len(x)\n",
        "    scale = torch.empty(n, device=x.device).uniform_(0.9, 1.1)\n",
        "    flip = torch.where(torch.rand(n, device=x.device) < 0.5, -1.0, 1.0)\n",
        "    theta = torch.zeros(n, 2, 3, device=x.device)\n",
        "    theta[:, 0, 0], theta[:, 1, 1] = scale * flip, scale\n",
        "    theta[:, :, 2] = torch.empty(n, 2, device=x.device).uniform_(-0.1, 0.1)\n",
        "    grid = F.affine_grid(theta, list(x.shape), align_corners=False)\n",
        "    return F.grid_sample(x, grid, padding_mode=\"zeros\", align_corners=False)\n",
        "\n",
        "\n",
        "def cnn_spec(name, cfg=CnnCfg()):\n",
        "    def fit(data, idx, watch_idx=None):\n",
        "        \"\"\"`watch_idx` only records per-epoch scores on those images for the curves; training never uses them.\"\"\"\n",
        "        torch.manual_seed(SEED)\n",
        "        images = torch.from_numpy(data.images[idx]).to(DEVICE)\n",
        "        y = torch.from_numpy(data.y[idx]).long().to(DEVICE)\n",
        "        counts = np.bincount(data.y[idx], minlength=len(CLASS_NAMES))\n",
        "        weights = torch.tensor(len(idx) / (len(counts) * counts), dtype=torch.float32, device=DEVICE)\n",
        "        model = small_cnn(cfg).to(DEVICE)\n",
        "        optimizer = torch.optim.AdamW(model.parameters(), lr=cfg.lr, weight_decay=cfg.weight_decay)\n",
        "        steps_per_epoch = int(np.ceil(len(idx) / cfg.batch))\n",
        "        schedule = torch.optim.lr_scheduler.OneCycleLR(optimizer, cfg.lr, total_steps=cfg.epochs * steps_per_epoch)\n",
        "        history = []\n",
        "        for epoch in tqdm(range(cfg.epochs), desc=name, leave=False):\n",
        "            model.train()\n",
        "            total, lr = torch.zeros((), device=DEVICE), schedule.get_last_lr()[0]\n",
        "            for batch in torch.randperm(len(idx), device=DEVICE).split(cfg.batch):\n",
        "                with torch.autocast(DEVICE, dtype=torch.bfloat16):\n",
        "                    loss = F.cross_entropy(model(augment(to_input(images[batch], cfg.size))), y[batch], weight=weights)\n",
        "                optimizer.zero_grad(set_to_none=True)\n",
        "                loss.backward()\n",
        "                optimizer.step()\n",
        "                schedule.step()\n",
        "                total += loss.detach() * len(batch)\n",
        "            row = {\"epoch\": epoch + 1, \"lr\": lr, \"train_loss\": total.item() / len(idx)}\n",
        "            if watch_idx is not None:\n",
        "                scores = torch.from_numpy(predict({\"model\": model, \"cfg\": cfg}, data, watch_idx))\n",
        "                y_watch = torch.from_numpy(data.y[watch_idx]).long()\n",
        "                row[\"watch_loss\"] = F.nll_loss(scores.clamp_min(1e-8).log(), y_watch, weight=weights.cpu()).item()\n",
        "                row[\"watch_macro_f1\"] = f1_score(y_watch, scores.argmax(1), labels=LABELS, average=\"macro\", zero_division=0)\n",
        "            history.append(row)\n",
        "        return {\"model\": model.eval(), \"cfg\": cfg, \"params\": \"fixed\", \"history\": pd.DataFrame(history)}\n",
        "\n",
        "    @torch.no_grad()\n",
        "    def predict(fitted, data, idx):\n",
        "        model, size = fitted[\"model\"].eval(), fitted[\"cfg\"].size\n",
        "        scores = []\n",
        "        for batch in torch.from_numpy(data.images[np.asarray(idx)]).split(64):\n",
        "            with torch.autocast(DEVICE, dtype=torch.bfloat16):\n",
        "                scores.append(model(to_input(batch.to(DEVICE), size)).float().softmax(1).cpu())\n",
        "        return torch.cat(scores).numpy()\n",
        "\n",
        "    def save(fitted, folder):\n",
        "        folder.mkdir(parents=True, exist_ok=True)\n",
        "        torch.save({\"state\": fitted[\"model\"].state_dict(), \"cfg\": asdict(fitted[\"cfg\"])}, folder / \"model.pt\")\n",
        "\n",
        "    def load(folder):\n",
        "        saved = torch.load(folder / \"model.pt\", map_location=DEVICE)\n",
        "        cfg = CnnCfg(**saved[\"cfg\"])\n",
        "        model = small_cnn(cfg).to(DEVICE)\n",
        "        model.load_state_dict(saved[\"state\"])\n",
        "        return {\"model\": model.eval(), \"cfg\": cfg, \"params\": \"fixed\"}\n",
        "\n",
        "    return ModelSpec(name, fit, predict, save, load)\n",
        "\n",
        "\n",
        "print(\"CNN device:\", DEVICE)"
      ]
    },
