        "SVM_GRID = [\n",
        "    {\"svc__kernel\": [\"linear\"], \"svc__C\": [0.01, 0.1]},\n",
        "    {\"svc__kernel\": [\"rbf\"], \"svc__C\": [1, 10, 100], \"svc__gamma\": [\"scale\", 1e-4]},\n",
        "]\n",
        "\n",
        "\n",
        "def svm_spec(name, blocks, grid=SVM_GRID, inner_folds=3):\n",
        "    def fit(data, idx):\n",
        "        search = GridSearchCV(\n",
        "            Pipeline([(\"scale\", StandardScaler()), (\"svc\", SVC(class_weight=\"balanced\", break_ties=True))]),\n",
        "            grid, scoring=\"f1_macro\", n_jobs=-1,\n",
        "            cv=StratifiedKFold(inner_folds, shuffle=True, random_state=SEED),\n",
        "        )\n",
        "        search.fit(features(data, blocks)[idx], data.y[idx])\n",
        "        return {\"model\": search.best_estimator_, \"params\": search.best_params_, \"blocks\": blocks}\n",
        "\n",
        "    def predict(fitted, data, idx):\n",
        "        return fitted[\"model\"].decision_function(features(data, fitted[\"blocks\"])[np.asarray(idx)])\n",
        "\n",
        "    def save(fitted, folder):\n",
        "        blocks = [(type(cfg).__name__, asdict(cfg)) for cfg in fitted[\"blocks\"]]\n",
        "        save_joblib({**fitted, \"blocks\": blocks}, folder)\n",
        "\n",
        "    def load(folder):\n",
        "        fitted = load_joblib(folder)\n",
        "        return {**fitted, \"blocks\": [CONFIG_TYPES[kind](**values) for kind, values in fitted[\"blocks\"]]}\n",
        "\n",
        "    return ModelSpec(name, fit, predict, save, load)"
      ]
