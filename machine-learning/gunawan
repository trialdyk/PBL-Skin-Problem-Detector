      "source": [
        "SCORES = [\"accuracy\", \"macro_f1\", \"balanced_accuracy\", \"qwk\", \"mae\"]\n",
        "\n",
        "\n",
        "def shared_folds(results, names):\n",
        "    return sorted(set.intersection(*(set(results[n][\"folds\"][\"fold\"]) for n in names)))\n",
        "\n",
        "\n",
        "def summarize(results, names=None):\n",
        "    names = names or list(results)\n",
        "    folds = shared_folds(results, names)\n",
        "    rows = pd.concat([results[n][\"folds\"] for n in names])\n",
        "    rows = rows[rows[\"fold\"].isin(folds)]\n",
        "    agg = rows.groupby(\"model\")[SCORES].agg([\"mean\", \"std\"])\n",
        "    table = pd.DataFrame({s: agg[(s, \"mean\")].map(\"{:.3f}\".format) + \" ± \" + agg[(s, \"std\")].map(\"{:.3f}\".format)\n",
        "                          for s in SCORES})\n",
        "    print(\"Folds used:\", folds)\n",
        "    return table.loc[agg[(\"macro_f1\", \"mean\")].sort_values(ascending=False).index]\n",
        "\n",
        "\n",
        "display(summarize(RESULTS))"
      ]
    },
