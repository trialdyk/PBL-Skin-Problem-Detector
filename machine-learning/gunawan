        "## 4. Features Extract For Classical MOdel\n",
        "\n",
        "cell below contain config and function for the following features extraction:\n",
        "\n",
        "- **HOG**\n",
        "- **LBP**\n",
        "- **HSV**\n",
        "\n",
        "**Produces:** `features(data, blocks)`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 15,
      "id": "fb4f5ff6",
      "metadata": {
        "id": "fb4f5ff6"
      },
      "outputs": [],
      "source": [
        "@dataclass(frozen=True)\n",
        "class HogCfg:\n",
        "    size: int = 128\n",
        "    cell: int = 16\n",
        "    block: int = 2\n",
        "    orientations: int = 9\n",
        "\n",
        "\n",
        "@dataclass(frozen=True)\n",
        "class LbpCfg:\n",
        "    size: int = 128\n",
        "    points: int = 8\n",
        "    radius: int = 1\n",
        "    grid: int = 4\n",
        "\n",
        "\n",
        "@dataclass(frozen=True)\n",
        "class HsvCfg:\n",
        "    size: int = 128\n",
        "    bins: tuple = (12, 8, 8)\n",
        "    grid: int = 2\n",
        "\n",
        "\n",
        "def at_size(img, box, size):\n",
        "    if size == img.shape[0]:\n",
        "        return img, box\n",
        "    scale = size / img.shape[0]\n",
        "    small = np.asarray(Image.fromarray(img).resize((size, size), Image.Resampling.LANCZOS))\n",
        "    return small, tuple(int(round(v * scale)) for v in box)\n",
        "\n",
        "\n",
        "def grid_cells(region, n):\n",
        "    return [cell for band in np.array_split(region, n, axis=0) for cell in np.array_split(band, n, axis=1)]\n",
        "\n",
        "\n",
        "def hog_features(img, box, cfg):\n",
        "    img, _ = at_size(img, box, cfg.size)\n",
        "    return hog(rgb2gray(img), orientations=cfg.orientations, pixels_per_cell=(cfg.cell, cfg.cell),\n",
        "               cells_per_block=(cfg.block, cfg.block), block_norm=\"L2-Hys\", feature_vector=True)\n",
        "\n",
        "\n",
        "def lbp_features(img, box, cfg):\n",
        "    img, (x0, y0, x1, y1) = at_size(img, box, cfg.size)\n",
        "    gray = (rgb2gray(img) * 255).astype(np.uint8)\n",
        "    codes = local_binary_pattern(gray, cfg.points, cfg.radius, method=\"uniform\")[y0:y1, x0:x1]\n",
        "    n_bins = cfg.points + 2\n",
        "    return np.concatenate([\n",
        "        np.histogram(cell, bins=n_bins, range=(0, n_bins))[0] / max(cell.size, 1)\n",
        "        for cell in grid_cells(codes, cfg.grid)\n",
        "    ])\n",
        "\n",
        "\n",
        "def hsv_features(img, box, cfg):\n",
        "    img, (x0, y0, x1, y1) = at_size(img, box, cfg.size)\n",
        "    hsv = rgb2hsv(img[y0:y1, x0:x1])\n",
        "    hists = []\n",
        "    for cell in grid_cells(hsv, cfg.grid):\n",
        "        for channel, bins in enumerate(cfg.bins):\n",
        "            counts = np.histogram(cell[..., channel], bins=bins, range=(0, 1))[0]\n",
        "            hists.append(counts / max(counts.sum(), 1))\n",
        "    return np.concatenate(hists)\n",
        "\n",
        "\n",
        "EXTRACTORS = {HogCfg: hog_features, LbpCfg: lbp_features, HsvCfg: hsv_features}\n",
        "CONFIG_TYPES = {cls.__name__: cls for cls in EXTRACTORS}\n",
        "FEATURE_CACHE = {}\n",
        "\n",
        "\n",
        "def block_matrix(data, cfg):\n",
        "    key = (data.key, cfg)\n",
        "    if data.key is None or key not in FEATURE_CACHE:\n",
        "        extract = EXTRACTORS[type(cfg)]\n",
        "        rows = [extract(img, box, cfg) for img, box in\n",
        "                tqdm(zip(data.images, data.boxes), total=len(data.y), desc=str(cfg), disable=data.key is None)]\n",
        "        matrix = np.stack(rows).astype(np.float32)\n",
        "        if data.key is None:\n",
        "            return matrix\n",
        "        FEATURE_CACHE[key] = matrix\n",
        "    return FEATURE_CACHE[key]\n",
        "\n",
        "\n",
        "def features(data, blocks):\n",
        "    return np.hstack([block_matrix(data, cfg) for cfg in blocks])"
      ]
    },
