        "def decode(path):\n",
        "    with Image.open(path) as opened:\n",
        "        img = upright(opened)\n",
        "    arr, box = letterbox(img)\n",
        "    return arr, box, img.size, pixel_hash(img)\n",
        "\n",
        "\n",
        "file_names = META[\"file_name\"].to_numpy(str)\n",
        "if DECODED_PATH.exists():\n",
        "    saved = np.load(DECODED_PATH)\n",
        "    assert np.array_equal(saved[\"file_name\"], file_names), f\"{DECODED_PATH} tidak cocok dengan data ini; hapus file itu\"\n",
        "    IMAGES, BOXES, sizes, hashes = saved[\"images\"], saved[\"boxes\"], saved[\"sizes\"], saved[\"hashes\"]\n",
        "    print(\"Loaded\", DECODED_PATH)\n",
        "else:\n",
        "    # Threads, not processes: Pillow releases the GIL while decoding and resizing.\n",
        "    with ThreadPoolExecutor() as pool:\n",
        "        decoded = list(tqdm(pool.map(decode, META[\"path\"]), total=len(META), desc=\"Decoding\"))\n",
        "    arrays, boxes, sizes, hashes = zip(*decoded)\n",
        "    IMAGES, BOXES, sizes, hashes = np.stack(arrays), np.array(boxes), np.array(sizes), np.array(hashes)\n",
        "    np.savez(DECODED_PATH, images=IMAGES, boxes=BOXES, sizes=sizes, hashes=hashes, file_name=file_names)\n",
        "    print(\"Saved\", DECODED_PATH)\n",
        "    del decoded, arrays\n",
        "\n",
        "META[\"width\"], META[\"height\"] = sizes[:, 0], sizes[:, 1]\n",
        "META[\"pixel_hash\"] = hashes\n",
        "print(IMAGES.shape, IMAGES.dtype, f\"{IMAGES.nbytes / 1e6:.0f} MB\")\n"
      ]
    },
