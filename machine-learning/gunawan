        "def majority_spec():\n",
        "    def fit(data, idx):\n",
        "        return {\"grade\": int(np.bincount(data.y[idx], minlength=len(CLASS_NAMES)).argmax())}\n",
        "\n",
        "    def predict(fitted, data, idx):\n",
        "        return np.eye(len(CLASS_NAMES))[np.full(len(idx), fitted[\"grade\"])]\n",
        "\n",
        "    return ModelSpec(\"majority\", fit, predict, save_joblib, load_joblib)\n"
      ]
