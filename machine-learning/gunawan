      "source": [
        "### Foto sendiri\n",
        "\n",
        "Set `IMAGE_PATH`, atau biarkan `None` lalu upload di Colab. Dataset tidak punya kelas \"kulit bersih\" terpisah — kulit tanpa jerawat masuk `IGA0_IGA1`, jadi setiap foto akan dapat salah satu dari 4 kelas itu.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "2463f785",
      "metadata": {
        "id": "2463f785"
      },
      "outputs": [],
      "source": [
        "IMAGE_PATH = None  # or set to a path to an image file, e.g. \"/path/to/image.png\"\n",
        "\n",
        "if IMAGE_PATH is None:\n",
        "    print(\"set IMAGE_PATH first man\")\n",
        "else:\n",
        "    name, photo = Path(IMAGE_PATH).name, Image.open(IMAGE_PATH)\n",
        "\n",
        "if IMAGE_PATH is not None:\n",
        "    data = photo_data(photo)\n",
        "    scores = MODELS[MODEL_NAME].predict(final_model(MODEL_NAME), data, [0])[0]\n",
        "    show_prediction(data.images[0], scores, f\"{name}\\n{MODEL_NAME}: {CLASS_NAMES[scores.argmax()]}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "b1a1d3cb",
      "metadata": {
        "id": "b1a1d3cb"
      },
      "source": [
        "## 8. Export\n",
        "\n",
        "Saves each model to `EXPORT_DIR/<name>/` with `info.json` (settings, cross-validated scores) and zips the folder."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "c38dd619",
      "metadata": {
        "id": "c38dd619"
      },
      "outputs": [],
      "source": [
        "EXPORT = [name for name in [\"svm_hog_lbp\", \"svm_hog_lbp_hsv\"] if name in MODELS]\n",
        "\n",
        "for name in EXPORT:\n",
        "    folder = EXPORT_DIR / name\n",
        "    fitted = final_model(name)\n",
        "    MODELS[name].save(fitted, folder)\n",
        "    cv = RESULTS[name][\"folds\"][SCORES].agg([\"mean\", \"std\"]).round(4).to_dict() if name in RESULTS else None\n",
        "    info = {\n",
        "        \"model\": name,\n",
        "        \"class_names\": CLASS_NAMES,\n",
        "        \"base_size\": BASE_SIZE,\n",
        "        \"params\": str(fitted.get(\"params\", \"\")),\n",
        "        \"trained_on_images\": int(len(DATA.y)),\n",
        "        \"holdout_images\": int(len(HOLDOUT.y)),\n",
        "        \"cross_validation\": cv,\n",
        "        \"holdout\": HOLDOUT_SCORES.loc[name].round(4).to_dict() if name in HOLDOUT_SCORES.index else None,\n",
        "        \"exported\": datetime.now().isoformat(timespec=\"seconds\"),\n",
        "    }\n",
        "    (folder / \"info.json\").write_text(json.dumps(info, indent=2))\n",
        "    print(\"Saved\", folder)\n",
        "\n",
        "archive = shutil.make_archive(str(EXPORT_DIR), \"zip\", EXPORT_DIR)\n",
        "print(\"Zip:\", archive)\n"
      ]
    },
