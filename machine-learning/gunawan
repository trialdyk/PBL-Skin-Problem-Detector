        "def upright(img):\n",
        "    \"\"\"Apply EXIF orientation and convert to RGB.\"\"\"\n",
        "    return ImageOps.exif_transpose(img).convert(\"RGB\")\n",
        "\n",
        "\n",
        "def pixel_hash(img):\n",
        "    return hashlib.sha256(f\"{img.size}\".encode() + img.tobytes()).hexdigest()\n",
        "\n",
        "\n",
        "def letterbox(img, size=BASE_SIZE):\n",
        "    \"\"\"Resize keeping aspect ratio, pad to a square. Returns the array and the content box (x0, y0, x1, y1).\"\"\"\n",
        "    scale = size / max(img.size)\n",
        "    new_w, new_h = max(1, round(img.width * scale)), max(1, round(img.height * scale))\n",
        "    resized = img.resize((new_w, new_h), Image.Resampling.LANCZOS)\n",
        "    canvas = Image.new(\"RGB\", (size, size), PAD_COLOR)\n",
        "    x0, y0 = (size - new_w) // 2, (size - new_h) // 2\n",
        "    canvas.paste(resized, (x0, y0))\n",
        "    return np.asarray(canvas), (x0, y0, x0 + new_w, y0 + new_h)\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class Data:\n",
        "    key: str | None\n",
        "    images: np.ndarray\n",
        "    boxes: np.ndarray\n",
        "    y: np.ndarray\n",
        "    meta: pd.DataFrame\n",
        "    is_test: np.ndarray\n",
        "\n",
        "    def fold(self, k):\n",
        "        return np.flatnonzero(~self.is_test[:, k]), np.flatnonzero(self.is_test[:, k])\n",
        "\n",
        "\n",
        "def metrics(y_true, y_pred):\n",
        "    recall = recall_score(y_true, y_pred, labels=LABELS, average=None, zero_division=0)\n",
        "    return {\n",
        "        \"accuracy\": accuracy_score(y_true, y_pred),\n",
        "        \"macro_f1\": f1_score(y_true, y_pred, labels=LABELS, average=\"macro\", zero_division=0),\n",
        "        \"balanced_accuracy\": balanced_accuracy_score(y_true, y_pred),\n",
        "        \"qwk\": cohen_kappa_score(y_true, y_pred, labels=LABELS, weights=\"quadratic\"),\n",
        "        \"mae\": float(np.abs(np.asarray(y_true) - np.asarray(y_pred)).mean()),\n",
        "        **{f\"recall_{name}\": r for name, r in zip(CLASS_NAMES, recall)},\n",
        "    }\n",
        "\n",
        "\n",
        "def show_grid(images, titles, ncols=4, size=2.6):\n",
        "    nrows = int(np.ceil(len(images) / ncols))\n",
        "    fig, axes = plt.subplots(nrows, ncols, figsize=(ncols * size, nrows * size), squeeze=False)\n",
        "    for ax in axes.flat:\n",
        "        ax.axis(\"off\")\n",
        "    for ax, img, title in zip(axes.flat, images, titles):\n",
        "        ax.imshow(img)\n",
        "        ax.set_title(title, fontsize=8)\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
      ]
    },
